{
  "manifest_version": 3,
  "name": "LinkedIn Job Skills Matcher",
  "version": "1.0",
  "description": "Extract job listing details from web pages",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "LinkedIn Job Skills Matcher",
    "default_popup": "popup.html",
    "default_icon": "images/icon48.png"
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"]
  }],
  "web_accessible_resources": [{
    "resources": ["images/icon16.png"],
    "matches": ["https://www.linkedin.com/*"]
  }],
  "host_permissions": ["<all_urls>"]
}